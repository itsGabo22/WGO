<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: adb-driven utterance injection for testing the voice pipeline without a microphone. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <receiver
            android:name="com.wgo.navigator.debug.UtteranceReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="${applicationId}.debug.UTTERANCE" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
