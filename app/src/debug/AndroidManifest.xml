<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: adb-driven utterance injection for testing the voice pipeline without a microphone, and a mock
     GPS drive for real watches (no `adb emu geo fix` there). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Debug-only mock drive (MockDriveReceiver): keeps replaying with the screen off. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application>
        <receiver
            android:name="com.wgo.navigator.debug.MockDriveReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="${applicationId}.debug.MOCK_DRIVE" />
            </intent-filter>
        </receiver>
        <receiver
            android:name="com.wgo.navigator.debug.UtteranceReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="${applicationId}.debug.UTTERANCE" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
